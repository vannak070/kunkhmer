{
  "openapi": "3.0.3",
  "info": {
    "title": "Kun Khmer Management System API",
    "description": "Production REST API specifying resources for Fighters, Bout Results, and Event schedules under the Kun Khmer Federation regulatory rules.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000/api",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/fighters": {
      "get": {
        "summary": "Retrieve registered fighters",
        "description": "Fetch a list of fighters optionally filtered by status or club ID.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "clubId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved fighters list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Fighter" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Register a new fighter profile",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FighterCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Fighter successfully registered as draft",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "$ref": "#/components/schemas/Fighter" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed / Invalid payload structure"
          }
        }
      }
    },
    "/fighters/{id}/verify": {
      "post": {
        "summary": "Federation officer verify/approve fighter profile",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fighter successfully verified and activated"
          },
          "404": {
            "description": "Fighter profile not found"
          }
        }
      }
    },
    "/matches": {
      "post": {
        "summary": "Create a new proposed fight bout match",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MatchCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bout successfully drafted and proposed"
          },
          "400": {
            "description": "Validation error or weight tolerance limit (±2kg) violated"
          }
        }
      }
    },
    "/matches/{id}/result": {
      "post": {
        "summary": "Record official bout scoring results",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BoutResult" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bout outcome recorded successfully"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Fighter": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "nameKhmer": { "type": "string" },
          "alias": { "type": "string" },
          "dateOfBirth": { "type": "string", "format": "date" },
          "nationality": { "type": "string" },
          "currentWeight": { "type": "number" },
          "height": { "type": "number" },
          "clubId": { "type": "string", "format": "uuid" },
          "grade": { "type": "string", "enum": ["A", "B", "C", "D"] },
          "status": { "type": "string" }
        }
      },
      "FighterCreate": {
        "type": "object",
        "required": ["name", "nameKhmer", "dateOfBirth", "currentWeight", "height"],
        "properties": {
          "name": { "type": "string" },
          "nameKhmer": { "type": "string" },
          "alias": { "type": "string" },
          "dateOfBirth": { "type": "string", "format": "date" },
          "nationality": { "type": "string", "default": "Cambodian" },
          "currentWeight": { "type": "number" },
          "height": { "type": "number" },
          "clubId": { "type": "string", "format": "uuid" },
          "grade": { "type": "string", "enum": ["A", "B", "C", "D"] }
        }
      },
      "MatchCreate": {
        "type": "object",
        "required": ["eventId", "subEventId", "fighterAId", "fighterBId", "rounds", "roundTime", "agreedWeight", "gloveSize", "gloveBrand"],
        "properties": {
          "eventId": { "type": "string", "format": "uuid" },
          "subEventId": { "type": "string", "format": "uuid" },
          "fighterAId": { "type": "string", "format": "uuid" },
          "fighterBId": { "type": "string", "format": "uuid" },
          "rounds": { "type": "integer", "enum": [3, 5] },
          "roundTime": { "type": "integer", "enum": [2, 3, 5] },
          "agreedWeight": { "type": "number" },
          "gloveSize": { "type": "string", "enum": ["6oz", "8oz", "10oz"] },
          "gloveBrand": { "type": "string" }
        }
      },
      "BoutResult": {
        "type": "object",
        "required": ["method", "round"],
        "properties": {
          "winnerId": { "type": "string", "format": "uuid", "nullable": true },
          "method": { "type": "string", "enum": ["KO", "TKO", "Decision", "Submission", "Draw", "No Contest"] },
          "round": { "type": "integer" },
          "duration": { "type": "string" }
        }
      }
    }
  }
}
