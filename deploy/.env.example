# Kun Khmer production settings — copy to deploy/.env and fill in. Never commit deploy/.env.

# Domains (point both at this server's IP with DNS "A" records before starting).
SITE_DOMAIN=kunkhmer.com
ADMIN_DOMAIN=admin.kunkhmer.com
# Email for the free HTTPS certificates (Let's Encrypt notices).
ACME_EMAIL=you@example.com

# Database password — long and random (e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=
# Secret for the Hub rate limit (e.g. `openssl rand -hex 32`).
AI_RATE_SALT=
# Password for the first Super Admin "admin" (at least 8 characters). Used only on the very first start,
# when the database is empty; after that, change passwords in the admin under My profile.
SEED_ADMIN_PASSWORD=

# true only when the site is ready to be found by Google (removes "noindex", robots.txt allows).
SITE_INDEXING=false

# KUNKHMER HUB (optional): your Anthropic API key and monthly spending cap in USD.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_MONTHLY_CAP_USD=50

# Days of daily backups to keep in deploy/backups/.
BACKUP_KEEP_DAYS=14

# Ports (leave 80/443 on a real server; change only to test on a computer where they're taken).
HTTP_PORT=80
HTTPS_PORT=443
